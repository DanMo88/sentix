{"id":11,"level":"A1","titleFa":"داشتن: have و has","sentences":[{"nl":"I have a question.","fa":"من یک سؤال دارم.","pr":"آی هَو اِ کوِسچِن."},{"nl":"She has a new job.","fa":"او یک کار جدید دارد.","pr":"شی هَز اِ نو جاب."},{"nl":"We have a meeting today.","fa":"ما امروز جلسه داریم.","pr":"وی هَو اِ میدینگ تِدِی."},{"nl":"He has two cars.","fa":"او دو ماشین دارد.","pr":"هی هَز تو کارز."},{"nl":"They have a beautiful home.","fa":"آن‌ها خانه زیبایی دارند.","pr":"دِی هَو اِ بیودِفِل هوم."},{"nl":"Do you have a pen?","fa":"خودکار داری؟","pr":"دو یو هَو اِ پِن؟"},{"nl":"My city has a big park.","fa":"شهر من یک پارک بزرگ دارد.","pr":"مای سیدی هَز اِ بیگ پارک."},{"nl":"I have a headache.","fa":"سرم درد می‌کند.","pr":"آی هَو اِ هِدِیک."},{"nl":"She has long hair.","fa":"او موی بلند دارد.","pr":"شی هَز لانگ هِر."},{"nl":"We have time.","fa":"ما وقت داریم.","pr":"وی هَو تایم."},{"nl":"He has a cold.","fa":"او سرما خورده است.","pr":"هی هَز اِ کولد."},{"nl":"They have three kids.","fa":"آن‌ها سه بچه دارند.","pr":"دِی هَو ثری کیدز."}],"reading":[{"nl":"My friend Emma has a new job.","fa":"دوستم اِما یک کار جدید دارد.","pr":"مای فرِند اِما هَز اِ نو جاب.","audio":"audio/rl-011-1.mp3"},{"nl":"She has a nice office and a big desk.","fa":"او یک دفتر خوب و یک میز بزرگ دارد.","pr":"شی هَز اِ نایس آفیس اَند اِ بیگ دِسک.","audio":"audio/rl-011-2.mp3"},{"nl":"Today she has a meeting.","fa":"امروز جلسه دارد.","pr":"تِدِی شی هَز اِ میدینگ.","audio":"audio/rl-011-3.mp3"},{"nl":"I have a headache, so I am at home.","fa":"سرم درد می‌کند، برای همین خانه هستم.","pr":"آی هَو اِ هِدِیک، سو آی اَم اَت هوم.","audio":"audio/rl-011-4.mp3"},{"nl":"We have time this evening.","fa":"امشب وقت داریم.","pr":"وی هَو تایم دیس ایونینگ.","audio":"audio/rl-011-5.mp3"},{"nl":"Do you have time too?","fa":"تو هم وقت داری؟","pr":"دو یو هَو تایم تو؟","audio":"audio/rl-011-6.mp3"}],"pron":{"i":"آی","have":"هَو","a":"اِ","question":"کوِسچِن","she":"شی","has":"هَز","new":"نو","job":"جاب","we":"وی","meeting":"میدینگ","today":"تِدِی","he":"هی","two":"تو","cars":"کارز","they":"دِی","beautiful":"بیودِفِل","home":"هوم","do":"دو","you":"یو","pen":"پِن","my":"مای","city":"سیدی","big":"بیگ","park":"پارک","headache":"هِدِیک","long":"لانگ","hair":"هِر","time":"تایم","cold":"کولد","three":"ثری","kids":"کیدز"}}